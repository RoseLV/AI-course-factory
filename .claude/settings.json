{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/hooks/stage_guard.py\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/course_status.py\" --hook"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(python scripts/check_package.py:*)",
      "Bash(python scripts/approve.py:*)",
      "Bash(python scripts/course_status.py:*)",
      "Bash(uv run --with markdown --with pygments python build/render.py:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git tag:*)",
      "Bash(git status:*)",
      "Bash(git log:*)"
    ]
  }
}
